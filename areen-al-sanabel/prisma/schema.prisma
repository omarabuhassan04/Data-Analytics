// عرين السنابل — نظام إدارة المخزون والمشتريات
// Areen Al-Sanabel — Inventory & Procurement System
//
// ملاحظة حول قاعدة البيانات / Database note:
// التطوير المحلي يستخدم SQLite لسهولة التشغيل بدون خادم.
// للانتقال إلى PostgreSQL: غيّر provider إلى "postgresql" وحدّث DATABASE_URL ثم شغّل
//   npx prisma migrate dev
// المخطط مصمّم ليكون متوافقًا مع Postgres: لا توجد أنواع خاصة بـ SQLite،
// والحقول التصنيفية (الدور/الحالة/النوع) مخزّنة كنصوص لأن SQLite لا يدعم enum في Prisma.
// قيم هذه الحقول محصورة ومُتحقَّق منها في طبقة التطبيق (src/lib/domain.ts + Zod).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"

  /*
    محرّك الاستعلام يُبنى لنظام التشغيل الذي وُلّد عليه العميل فقط.
    البناء يجري على Windows بينما دوال Netlify تعمل على Linux، فينتهي
    الأمر بحزمة تحمل محرّك ويندوز وحده وتفشل كل استعلامات قاعدة البيانات
    في الإنتاج برسالة «database: unreachable».

    "native" يبقي التطوير المحلي يعمل، و"rhel-openssl-3.0.x" هو المطلوب
    لبيئة تشغيل Node 20 على Netlify/AWS Lambda.
  */
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

/// المستخدمون — تُنشأ الحسابات يدويًا من قِبل قائد اللوازم (لا يوجد تسجيل ذاتي)
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  fullName     String
  passwordHash String
  /// SUPPLIES_LEADER | TEAM_LEADER | GROUP_LEADER | DEPUTY_GROUP_LEADER | SCOUTS_LEADER
  role         String
  /// اسم الفرقة — لمسؤولي الفرق فقط
  teamName     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests     Request[]     @relation("RequestRequester")
  decisions    Request[]     @relation("RequestDecider")
  notes        RequestNote[]
  activityLogs ActivityLog[]

  @@index([role])
}

/// تصنيفات العتاد الكشفي
model Category {
  id        Int    @id @default(autoincrement())
  name      String @unique
  /// مفتاح أيقونة lucide لعرضها في الواجهة
  icon      String @default("package")
  sortOrder Int    @default(0)

  items Item[]
}

/// أغراض المخزون
model Item {
  id         Int      @id @default(autoincrement())
  name       String
  /// وحدة القياس: قطعة، متر، علبة ...
  unit       String   @default("قطعة")
  /// الكمية المتاحة للصرف حاليًا (تُخصم فور تقديم طلب العهدة)
  quantity   Int      @default(0)
  /// كمية راجعة محتجزة في فحص الجودة — موجودة في المقر لكنها غير قابلة للصرف
  quarantine Int      @default(0)
  /// الحد الأدنى للتنبيه بانخفاض المخزون
  threshold  Int      @default(0)
  notes      String?
  photoUrl   String?
  isActive   Boolean  @default(true)
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category  Category        @relation(fields: [categoryId], references: [id])
  lines     RequestLine[]
  movements StockMovement[]

  @@unique([name, categoryId])
  @@index([categoryId])
}

/// الطلبات — عهدة / كمية إضافية / شراء
model Request {
  id           Int       @id @default(autoincrement())
  /// EQUIPMENT (عهدة) | ADDITIONAL (كمية إضافية) | PURCHASE (شراء)
  type         String
  /// PENDING | UNDER_REVIEW | APPROVED | REJECTED | CANCELLED
  status       String    @default("PENDING")
  requesterId  Int
  /// نسخة من اسم الفرقة وقت التقديم (حتى لو تغيّر لاحقًا)
  teamName     String
  /// الغرض من الطلب / المناسبة
  purpose      String?
  /// تاريخ الحاجة
  neededOn     DateTime?
  decidedById  Int?
  decidedAt    DateTime?
  /// سبب القبول أو الرفض
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requester User          @relation("RequestRequester", fields: [requesterId], references: [id])
  decidedBy User?         @relation("RequestDecider", fields: [decidedById], references: [id])
  lines     RequestLine[]
  notes     RequestNote[]

  @@index([requesterId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

/// أسطر الطلب
///
/// دفتر حساب السطر الواحد. كل العدّادات تراكمية ولا تُصفَّر، والكمية المعلّقة
/// (ما زال في يد الفرقة) تُحسب دائمًا بالطرح:
///   outstanding = deducted - released - returned - quarantined - writtenOff
/// انظر lineOutstanding() في src/lib/domain.ts — هي المرجع الوحيد لهذه المعادلة.
model RequestLine {
  id          Int     @id @default(autoincrement())
  requestId   Int
  /// يكون فارغًا في طلبات شراء أغراض غير موجودة أصلًا في المخزون
  itemId      Int?
  /// نسخة من اسم الغرض وقت الطلب (أو الاسم الحر في طلب الشراء)
  itemName    String
  unit        String  @default("قطعة")
  quantity    Int
  /// إجمالي ما خُصم من المخزون لهذا السطر — لا يتغيّر بعد إنشاء الطلب
  deducted    Int     @default(0)
  /// ما أُعيد لأن الطلب رُفض أو أُلغي قبل التسليم (فكّ الحجز)
  released    Int     @default(0)
  /// ما رجع فعليًا بعد التسليم ودخل المخزون المتاح
  returned    Int     @default(0)
  /// ما رجع محتجزًا في فحص الجودة وما زال محتجزًا الآن
  quarantined Int     @default(0)
  /// ما شُطب نهائيًا: مفقود أو تالف لا يُصلَح
  writtenOff  Int     @default(0)
  note        String?

  request   Request         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item      Item?           @relation(fields: [itemId], references: [id])
  movements StockMovement[]

  @@index([requestId])
  @@index([itemId])
}

/// دفتر حركة المخزون — السجل المحاسبي الذي تُشتقّ منه كل الأرصدة
///
/// كل تغيّر في كمية أي غرض يمرّ من هنا حصرًا (src/lib/stock.ts).
/// شرط المطابقة الذي يفرضه /api/inventory/reconcile:
///   SUM(availableDelta) = Item.quantity   و   SUM(quarantineDelta) = Item.quarantine
model StockMovement {
  id            Int    @id @default(autoincrement())
  itemId        Int
  /// OPENING | RECEIVE | ADJUST | RESERVE | RELEASE | RETURN | QC_HOLD | QC_RELEASE | QC_WRITE_OFF | WRITE_OFF
  reason        String
  /// عدد الوحدات التي يخصّها الحدث — موجب دائمًا، للقراءة البشرية
  units         Int
  /// أثر الحدث على الكمية المتاحة (سالب = خرجت من المخزون)
  availableDelta  Int  @default(0)
  /// أثر الحدث على كمية فحص الجودة
  quarantineDelta Int  @default(0)
  /// رصيد ما بعد الحركة — لقطة تدقيق تُغني عن إعادة الحساب
  availableAfter  Int
  quarantineAfter Int

  requestId     Int?
  requestLineId Int?
  actorId       Int?
  /// نسخة من اسم المنفّذ حتى لو حُذف الحساب لاحقًا
  actorName     String
  note          String?
  createdAt     DateTime @default(now())

  item        Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  requestLine RequestLine? @relation(fields: [requestLineId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([requestId])
  @@index([requestLineId])
  @@index([reason])
  @@index([createdAt])
}

/// ملاحظات على الطلبات (قائد الكشافين + قائد اللوازم)
model RequestNote {
  id        Int      @id @default(autoincrement())
  requestId Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([requestId])
}

/// سجل النشاط — مسار تدقيق كامل لقائد اللوازم
model ActivityLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  /// نسخة من اسم المنفّذ حتى لو حُذف الحساب لاحقًا
  actorName String
  /// LOGIN | ITEM_CREATE | REQUEST_SUBMIT | REQUEST_APPROVE ...
  action    String
  /// Request | Item | User | Auth
  entity    String
  entityId  Int?
  /// وصف عربي جاهز للعرض
  summary   String
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}
